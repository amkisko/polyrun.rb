# frozen_string_literal: true

# Generated by: polyrun init --profile rails-prepare-task
# Runs once before parallel workers. Skip: POLYRUN_SKIP_PREPARE=1 (legacy: POLYRUN_START_SKIP_PREPARE=1).

namespace :polyrun do
  desc "One-shot Polyrun prepare (delegates to `polyrun prepare`)"
  task prepare: :environment do
    skip = %w[1 true yes].include?(ENV["POLYRUN_SKIP_PREPARE"].to_s.downcase) ||
      %w[1 true yes].include?(ENV["POLYRUN_START_SKIP_PREPARE"].to_s.downcase)
    next if skip

    ok = system({"RUBYOPT" => nil}, "bundle", "exec", "polyrun", "prepare")
    abort "polyrun prepare failed" unless ok
  end
end
